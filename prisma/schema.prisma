generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Status{
  TODO
  IN_PROGRESS
  DONE
}
 
model User {
  id Int @id @default(autoincrement())
  email String @unique
  passwordHash String
  tasks Task[]
}

model Task {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id])
  title String
  description String?
  status Status @default(TODO)
}